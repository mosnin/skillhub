# Neon Database
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/skillhub?sslmode=require

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLATFORM_FEE_PERCENT=20

# VirusTotal (optional — free API key for security scanning)
# Sign up free at https://www.virustotal.com/gui/join-us
# Free tier: 500 requests/day, 4 requests/minute
VIRUSTOTAL_API_KEY=

# GitHub (optional — increases rate limits for GitHub import)
# Create at https://github.com/settings/tokens (public_repo scope only)
GITHUB_TOKEN=
